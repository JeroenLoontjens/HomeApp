<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AppForLogin.Views.Generic"
             x:Class="AppForLogin.Views.Generic.CategoryTreeView">

    <VerticalStackLayout BackgroundColor="Transparent" Spacing="0">

        <!-- Header row (Category) -->
        <Border Stroke="White"
                StrokeThickness="1"
                Padding="0"
                Margin="0,0,0,6"
                BackgroundColor="Transparent">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <Grid Padding="0"
                  ColumnDefinitions="44,*"
                  BackgroundColor="Transparent">

                <!-- The actual row content in Transaction look & feel -->
                <local:RowGrid Grid.Column="0"
                               Grid.ColumnSpan="2"
                               LeftIcon="{Binding Category.Icon}"
                               LeftIconBackgroundColor="{Binding Category.ColorHex}"
                               MainText="{Binding Category.Name}"
                               SubText="{Binding SubText}"
                               IndentLevel="{Binding Level}"
                               BackgroundColor="AliceBlue"
                               Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCategoryDetailCommand}"
                               CommandParameter="{Binding .}" />

                <!-- Chevron button on top (separate tap target for expand/collapse) -->
                <ImageButton Grid.Column="1"
                             Source="{Binding Icon}"
                             BackgroundColor="Transparent"
                             WidthRequest="10"
                             HeightRequest="10"
                             Scale="0.5"
                             Padding="4"
                             Margin="6,0,0,0"
                             HorizontalOptions="End"
                             VerticalOptions="Center"
                             Command="{Binding ToggleExpandCommand}"
                             IsVisible="{Binding HasChildren}" />
            </Grid>
        </Border>

        <!-- Children -->
        <CollectionView ItemsSource="{Binding Children}"
                        IsVisible="{Binding IsExpanded}"
                        Margin="0,0,0,6">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <local:CategoryTreeView />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentView>