<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:AppForLogin.ViewModel"
             xmlns:model="clr-namespace:DataAccess.Model;assembly=DataAccess"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="AppForLogin.Views.CreateBudgetItemPage"
             x:DataType="viewmodel:CreateBudgetItemViewModel"
             Title="Create Budget Item">
    
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <Label Text="Create New Budget Item"
                   FontSize="24"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"/>

            <!-- Category Selection -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Category"
                       FontSize="16"
                       FontAttributes="Bold"/>
                <Picker ItemsSource="{Binding Categories}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                        Title="Select a category"/>
            </VerticalStackLayout>

            <!-- Period Selection -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Period"
                       FontSize="16"
                       FontAttributes="Bold"/>
                <DatePicker Date="{Binding Period, Mode=TwoWay}"
                            MinimumDate="{x:Static sys:DateTime.Now}"/>
            </VerticalStackLayout>

            <!-- Planned Amount -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Planned Amount"
                       FontSize="16"
                       FontAttributes="Bold"/>
                <Entry Keyboard="Numeric"
                       Placeholder="Enter planned amount"
                       Text="{Binding PlannedAmount, Mode=TwoWay}"/>
            </VerticalStackLayout>

            <!-- Optional Description -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Description (Optional)"
                       FontSize="16"
                       FontAttributes="Bold"/>
                <Entry Placeholder="Optional description for initial transaction"
                       Text="{Binding Description, Mode=TwoWay}"/>
            </VerticalStackLayout>

            <!-- Action Buttons -->
            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                <Button Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="#FF5252"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="20,10"/>
                
                <Button Text="Create Budget Item"
                        Command="{Binding CreateBudgetItemCommand}"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="20,10"/>
            </HorizontalStackLayout>
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>