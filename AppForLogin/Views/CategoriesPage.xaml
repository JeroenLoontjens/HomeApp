<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:DataAccess.Model;assembly=DataAccess"
             x:Class="AppForLogin.Views.CategoriesPage"
             Title="Budget Dashboard"
             xmlns:converters="clr-namespace:AppForLogin.Converters"
             xmlns:local="clr-namespace:AppForLogin.Views.Generic"
             BackgroundColor="White">

   
    <CollectionView ItemsSource="{Binding RootCategories}" BackgroundColor="White">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <local:CategoryTreeView />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

          
       

</ContentPage>
