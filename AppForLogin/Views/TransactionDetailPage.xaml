<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:DataAccess.Model;assembly=DataAccess"
             x:Class="AppForLogin.Views.TransactionDetailPage"
             xmlns:viewmodels="clr-namespace:AppForLogin.ViewModel"
             xmlns:converters="clr-namespace:AppForLogin.Converters"
             xmlns:controls="clr-namespace:AppForLogin.Views.Generic"
             Title="Transaction Details">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BudgetLinePickerDisplayConverter x:Key="BudgetLinePickerDisplayConverter" />
            <converters:TransactionSplitSubTextConverter x:Key="TransactionSplitSubTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" BackgroundColor="White">

            <!-- Buttons -->
            <HorizontalStackLayout Spacing="12" HorizontalOptions="End">
                <Button Text="Save"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                <Button Text="Delete" BackgroundColor="Red"
                        Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                <Button Text="Approve" BackgroundColor="Green"
                        Command="{Binding ApproveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                <Button Text="Undo Changes"
                        Command="{Binding CancelCommand}" />

                <Button Text="Go Back"
                        Command="{Binding ReturnCommand}" />
            </HorizontalStackLayout>

            <Label Text="Description" TextColor="Black" />
            <Entry Text="{Binding Transaction.Description}" TextColor="black" Placeholder="Omschrijving" PlaceholderColor="LightGray" BackgroundColor="AliceBlue" />

            <Label Text="Amount" TextColor="Black" />
            <Entry Text="{Binding Transaction.Amount}" Keyboard="Numeric" TextColor="Black" BackgroundColor="AliceBlue" />

            <Label Text="Date" TextColor="Black" />
            <DatePicker Date="{Binding Transaction.Date}" BackgroundColor="AliceBlue" TextColor="Black"/>

            <Label Text="Status" TextColor="Black" />
            <Picker BackgroundColor="AliceBlue"
                    ItemsSource="{x:Static model:StatusValues.All}"
                    SelectedItem="{Binding Transaction.Status}" TextColor="Black" />

            <Label Text="Is Income" TextColor="Black" />
            <Switch IsToggled="{Binding Transaction.IsIncome}" OnColor="Green" OffColor="LightGray" />

            <!-- Split card -->
            <Frame Padding="12" CornerRadius="16" BackgroundColor="#F2F6FF">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Splitsing toevoegen" TextColor="Purple" FontAttributes="Bold" />

                    <SearchBar Placeholder="search filter for BudgetLinepicker..."
                   Text="{Binding BudgetLineSearchText}" BackgroundColor="White" PlaceholderColor="LightGray" />

                    <Picker Title="BudgetLine picker" TitleColor="Black"
                ItemsSource="{Binding FilteredBudgetLines}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource BudgetLinePickerDisplayConverter}}"
                SelectedItem="{Binding SelectedBudgetLine}"
                            BackgroundColor="White" TextColor="Black"/>


                    <Label Text="Amount" TextColor="black"/>
                    <Entry Placeholder="Bedrag" PlaceholderColor="Black" 
               Text="{Binding SplitAmount}" TextColor="Black" BackgroundColor="White"
               Keyboard="Numeric" />

                    <Button Text="+ Split toevoegen"
                Command="{Binding AddSplitCommand}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Splits Made" TextColor="black" FontAttributes="Bold" />
            <!-- Split lijst -->
            <CollectionView ItemsSource="{Binding Transaction.TransactionBudgetLines}" BackgroundColor="AliceBlue">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:TransactionBudgetLine">
                        <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                                            
                  Padding="4,2">
                            <controls:RowGrid
                    Grid.Column="0"
                    MainText="{Binding BudgetLine.Notes}"
                    SubText="{Binding ., Converter={StaticResource TransactionSplitSubTextConverter}}"
                    RightText="{Binding AmountAllocated, StringFormat='€{0:F2}'}" />

                            <Button Grid.Column="1"
                        Text="Remove"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveSplitCommand}"
                        CommandParameter="{Binding .}"
                        BackgroundColor="Transparent"
                        TextColor="Crimson"
                        BorderColor="Crimson"
                        BorderWidth="4"
                        HeightRequest="50"
                        CornerRadius="12"
                        Padding="5,3" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>


</ContentPage>