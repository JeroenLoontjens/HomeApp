<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppForLogin.Views.BudgetPage"
             Title="Budget Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Titel -->
            <Label Text="Persoonlijk Budget" 
                   FontSize="24" 
                   HorizontalOptions="Center" 
                   FontAttributes="Bold" />

            <!-- Formulier voor nieuwe transactie -->
            <Border Stroke="Gray" Padding="10">
                <VerticalStackLayout Spacing="10">
                    <Entry Placeholder="Datum (dd-mm-jjjj)" />
                    <Entry Placeholder="Categorie (bv. Huur, Boodschappen)" />
                    <Entry Placeholder="Bedrag" Keyboard="Numeric" />
                    <Picker Title="Type">
                        <Picker.Items>
                            <x:String>Inkomen</x:String>
                            <x:String>Uitgave</x:String>
                        </Picker.Items>
                    </Picker>
                    <Button Text="Transactie toevoegen" BackgroundColor="Green" TextColor="White"/>
                </VerticalStackLayout>
            </Border>

            <!-- Lijst van transacties -->
            <Label Text="Transacties" FontAttributes="Bold" />
            <CollectionView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="5" BackgroundColor="Beige">
                            <VerticalStackLayout>
                                <Label Text="Datum: {Binding Date}" FontAttributes="Bold"/>
                                <Label Text="Categorie: {Binding Category}" />
                                <Label Text="Bedrag: {Binding Amount}" />
                                <Label Text="Type: {Binding IsIncome}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Dashboard sectie -->
            <Label Text="Dashboard" FontAttributes="Bold" />
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="LightGreen" Padding="10">
                    <Label Text="Totaal Inkomsten: €0" />
                </Frame>
                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="LightCoral" Padding="10">
                    <Label Text="Totaal Uitgaven: €0" />
                </Frame>
                <Frame Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="LightBlue" Padding="10">
                    <Label Text="Saldo: €0" HorizontalOptions="Center"/>
                </Frame>
            </Grid>

            <!-- CSV Import -->
            <Button Text="Importeer CSV" BackgroundColor="Purple" TextColor="White"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
